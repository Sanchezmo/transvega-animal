# =============================================================================
# TRANSVEGA ANIMAL - Variables de Entorno (NATIVO)
# =============================================================================
# Copiar a .env y completar con valores reales
# NUNCA commitear .env con secretos reales
# =============================================================================

# =============================================================================
# ENTORNO GENERAL
# =============================================================================
TRANSVEGA_ENV=development          # development | staging | production
PROJECT_ROOT=/home/saulo/transvega-animal   # Se auto-detecta en scripts

# =============================================================================
# DOLIBARR 23.0.4 (NATIVO - Apache + MariaDB)
# =============================================================================
DOLIBARR_VERSION=23.0.4
DOLIBARR_ROOT=${PROJECT_ROOT}/dolibarr-23.0.4
DOLIBARR_HTDOCS=${DOLIBARR_ROOT}/htdocs
DOLIBARR_DOCUMENTS=${DOLIBARR_ROOT}/documents
DOLIBARR_CONF_DIR=${DOLIBARR_ROOT}/conf
DOLIBARR_CUSTOM_DIR=${DOLIBARR_ROOT}/custom

# Base de datos Dolibarr (MariaDB nativo)
DOLIBARR_DB_HOST=127.0.0.1
DOLIBARR_DB_PORT=3306
DOLIBARR_DB_NAME=dolibarr
DOLIBARR_DB_USER=dolibarr
DOLIBARR_DB_PASSWORD=                # Generar: openssl rand -base64 32
DOLIBARR_DB_ROOT_PASSWORD=           # Generar: openssl rand -base64 32

# API Dolibarr (Local - Apache en puerto 8080)
DOLIBARR_LOCAL_URL=http://127.0.0.1:8080
DOLIBARR_API_URL=${DOLIBARR_LOCAL_URL}/api/index.php
DOLIBARR_API_KEY=                    # Generar en Dolibarr: Configuración > API > Claves API

# Dolibarr Público (Cloudflare Tunnel)
DOLIBARR_PUBLIC_HOST=                # ej: dolibarr-staging.mascotalegal.es
DOLIBARR_PUBLIC_URL=https://${DOLIBARR_PUBLIC_HOST}

# =============================================================================
# APACHE (NATIVO)
# =============================================================================
APACHE_PORT=8080
DOLIBARR_VHOST_NAME=dolibarr.local
APACHE_LOG_DIR=/var/log/apache2

# =============================================================================
# MARIADB (NATIVO - Para Dolibarr)
# =============================================================================
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_ROOT_PASSWORD=${DOLIBARR_DB_ROOT_PASSWORD}

# =============================================================================
# POSTGRESQL AUDITORÍA (NATIVO - Independiente de Dolibarr)
# =============================================================================
AUDIT_DB_HOST=127.0.0.1
AUDIT_DB_PORT=5432
AUDIT_DB_NAME=audit
AUDIT_DB_USER=audit
AUDIT_DB_PASSWORD=                   # Generar: openssl rand -base64 32
# URL computada (no editar manualmente)
AUDIT_DB_URL=postgresql://${AUDIT_DB_USER}:${AUDIT_DB_PASSWORD}@${AUDIT_DB_HOST}:${AUDIT_DB_PORT}/${AUDIT_DB_NAME}

# =============================================================================
# REDIS (NATIVO - Cola Celery + Cache + Idempotencia)
# =============================================================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=                      # Generar: openssl rand -base64 32
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=allkeys-lru
# URL computada (no editar manualmente)
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

# =============================================================================
# SEGURIDAD LOCAL (JWT, Cifrado, Firmas)
# =============================================================================
JWT_SECRET_KEY=                      # Generar: openssl rand -base64 64
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=7

FERNET_KEY=                          # Generar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# API Keys por agente (rotación 90 días - requeridas para arranque)
AGENT_API_KEY_SUPERVISOR=
AGENT_API_KEY_PRODUCTS=
AGENT_API_KEY_COMPLIANCE=
AGENT_API_KEY_PUBLISHING=
AGENT_API_KEY_SALES=
AGENT_API_KEY_INVOICING=
AGENT_API_KEY_PURCHASES=
AGENT_API_KEY_BANKING=
AGENT_API_KEY_ACCOUNTING=
AGENT_API_KEY_TAX=
AGENT_API_KEY_MARKETING=
AGENT_API_KEY_TECHNICAL=
AGENT_API_KEY_DOG_INTAKE=
AGENT_API_KEY_EXPEDIENTES=
AGENT_API_KEY_FACTURACION=
AGENT_API_KEY_LISTING=

# =============================================================================
# API INTEGRACIÓN / HERMES (FastAPI - NATIVO en .venv + systemd)
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_ENVIRONMENT=development
API_CORS_ORIGINS=http://localhost:3000,http://localhost:8002,https://hermes.transvega-animal.es

# Internal API URL (service-to-service)
INTERNAL_API_URL=http://127.0.0.1:8000/api/v1

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Idempotencia
IDEMPOTENCY_TTL_HOURS=24

# =============================================================================
# SERVICIO APROBACIONES (NATIVO - FastAPI en .venv + systemd)
# =============================================================================
APPROVALS_HOST=127.0.0.1
APPROVALS_PORT=8002
APPROVALS_SERVICE_URL=http://127.0.0.1:8002

# Notificaciones aprobaciones (webhook Telegram/Slack/Email)
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=

# =============================================================================
# COLAS Y WORKERS (Celery - NATIVO en .venv + systemd)
# =============================================================================
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=["json"]
CELERY_TIMEZONE=Europe/Madrid
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=3600
CELERY_WORKER_PREFETCH_MULTIPLIER=4
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_DEFAULT_QUEUE=default

# Colas específicas
QUEUE_HIGH_PRIORITY=high
QUEUE_DEFAULT=default
QUEUE_LOW_PRIORITY=low
QUEUE_APPROVALS=approvals
QUEUE_NOTIFICATIONS=notifications

# =============================================================================
# OLLAMA (NATIVO - systemd)
# =============================================================================
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_ENDPOINT=http://${OLLAMA_HOST}:${OLLAMA_PORT}
OLLAMA_MODEL=transvega-local
OLLAMA_BASE_MODEL=qwen3.5:4b-q4_K_M

# =============================================================================
# CLOUDFLARE TUNNEL (NATIVO - cloudflared + systemd)
# =============================================================================
CLOUDFLARE_API_TOKEN=                # Zone:Read, DNS:Edit, Access:Edit
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_TUNNEL_TOKEN=             # Para cloudflared systemd (staging)
CLOUDFLARE_TUNNEL_TOKEN_PROD=        # Para cloudflared systemd (production)
CLOUDFLARE_ACCESS_AUD=               # Audience para Cloudflare Access

# Dominios
DOMAIN=mascotalegal.es
DOLIBARR_PUBLIC_HOST=dolibarr-staging.${DOMAIN}
HERMES_PUBLIC_HOST=hermes.transvega-animal.es
TELEGRAM_WEBHOOK_HOST=telegram.transvega-animal.es

# =============================================================================
# TELEGRAM
# =============================================================================
TELEGRAM_BOT_TOKEN=                  # Obtener de @BotFather
TELEGRAM_WEBHOOK_SECRET=             # Generar: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET_REQUIRED=true
TELEGRAM_UPDATE_IDEMPOTENCY_TTL_HOURS=24
TELEGRAM_INVOICE_MAX_FILE_SIZE_MB=10

# =============================================================================
# NVIDIA MODEL PROVIDER (Cloud - para tareas públicas/no sensibles)
# =============================================================================
NVIDIA_API_KEY=                      # Obtener en https://build.nvidia.com/
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TEXT_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_VISION_MODEL=meta/llama-3.2-90b-vision-instruct

# =============================================================================
# GOOGLE WORKSPACE
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WORKSPACE_DOMAIN=transvega-animal.es
GOOGLE_ADMIN_EMAIL=admin@transvega-animal.es
GOOGLE_SERVICE_ACCOUNT_JSON=

# Cuentas funcionales
GMAIL_VENTAS=ventas@transvega-animal.es
GMAIL_ADMINISTRACION=administracion@transvega-animal.es
GMAIL_FACTURACION=facturacion@transvega-animal.es
GMAIL_DOCUMENTACION=documentacion@transvega-animal.es
GMAIL_TRANSPORTE=transporte@transvega-animal.es
GMAIL_PRIVACIDAD=privacidad@transvega-animal.es

# =============================================================================
# BACKUPS
# =============================================================================
BACKUP_SCHEDULE="0 2 * * *"          # Diario 02:00
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_KEY=               # Generar: openssl rand -base64 32
BACKUP_GDRIVE_FOLDER_ID=
BACKUP_LOCAL_PATH=/var/backups/transvega
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# =============================================================================
# MONITORIZACIÓN (Opcional - mantener en Docker si se usa)
# =============================================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=
LOKI_PORT=3100
ALERTMANAGER_PORT=9093

# =============================================================================
# VERIFACTU (Fase posterior)
# =============================================================================
VERIFACTU_PROVIDER=
VERIFACTU_CERT_PATH=
VERIFACTU_KEY_PATH=
VERIFACTU_TEST_MODE=true

# =============================================================================
# GESTORÍA PARALELA
# =============================================================================
GESTORIA_CONTACT_EMAIL=
GESTORIA_CONTACT_NAME=
GESTORIA_COMPARISON_SCHEDULE="0 9 1 * *"

# =============================================================================
# DESARROLLO / TESTING (Solo para tests, no producción)
# =============================================================================
PYTEST_DATABASE_URL=postgresql://audit:test@127.0.0.1:55432/transvega_test
MOCK_DOLIBARR_ENABLED=false
MOCK_DOLIBARR_PORT=8001
SEED_FAKE_DATA=true

# =============================================================================
# VPS HOSTINGER (Solo para deploy remoto)
# =============================================================================
VPS_IP=
VPS_SSH_USER=root
VPS_SSH_KEY_PATH=~/.ssh/transvega_vps