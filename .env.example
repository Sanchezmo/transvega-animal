# Transvega Animal - Variables de Entorno
# Copiar a .env.local y completar con valores reales
# NUNCA commitear .env.local

# =============================================================================
# DOMINIO Y CLOUDFLARE
# =============================================================================
DOMAIN=transvega-animal.es
CLOUDFLARE_API_TOKEN=                    # Zone:Read, DNS:Edit, Access:Edit
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_TUNNEL_TOKEN=                 # Para Cloudflare Tunnel local
CLOUDFLARE_ACCESS_AUD=                   # Audience para Cloudflare Access

# =============================================================================
# VPS HOSTINGER
# =============================================================================
VPS_IP=
VPS_SSH_USER=root
VPS_SSH_KEY_PATH=~/.ssh/transvega_vps

# =============================================================================
# GOOGLE WORKSPACE
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WORKSPACE_DOMAIN=transvega-animal.es
GOOGLE_ADMIN_EMAIL=admin@transvega-animal.es
GOOGLE_SERVICE_ACCOUNT_JSON=             # Path a JSON service account

# Cuentas funcionales (se crean en Workspace)
GMAIL_VENTAS=ventas@transvega-animal.es
GMAIL_ADMINISTRACION=administracion@transvega-animal.es
GMAIL_FACTURACION=facturacion@transvega-animal.es
GMAIL_DOCUMENTACION=documentacion@transvega-animal.es
GMAIL_TRANSPORTE=transporte@transvega-animal.es
GMAIL_PRIVACIDAD=privacidad@transvega-animal.es

# =============================================================================
# DOLIBARR (ERP/CRM - Fuente oficial de datos)
# =============================================================================
DOLIBARR_API_URL=https://erp.transvega-animal.es/api/index.php
DOLIBARR_API_KEY=
DOLIBARR_DB_HOST=localhost
DOLIBARR_DB_NAME=dolibarr
DOLIBARR_DB_USER=dolibarr
DOLIBARR_DB_PASSWORD=
DOLIBARR_VERSION=19.0

# Módulo personalizado expediente_animal
DOLIBARR_MODULE_EXPEDIENTE_ANIMAL_ENABLED=true

# =============================================================================
# BASE DE DATOS AUDITORÍA (PostgreSQL - Independiente de Dolibarr)
# =============================================================================
AUDIT_DB_HOST=audit-db
AUDIT_DB_PORT=5432
AUDIT_DB_NAME=audit
AUDIT_DB_USER=audit
AUDIT_DB_PASSWORD=                       # Generar: openssl rand -base64 32
AUDIT_DB_URL=postgresql://audit:${AUDIT_DB_PASSWORD}@audit-db:5432/audit

# =============================================================================
# REDIS (Cola de tareas Celery)
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=                          # Generar: openssl rand -base64 32
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# =============================================================================
# SEGURIDAD LOCAL (JWT, Cifrado, Firmas)
# =============================================================================
JWT_SECRET_KEY=                          # Generar: openssl rand -base64 64
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=7

FERNET_KEY=                              # Generar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# API Keys por agente (rotación 90 días)
AGENT_API_KEY_SUPERVISOR=
AGENT_API_KEY_PRODUCTS=
AGENT_API_KEY_COMPLIANCE=
AGENT_API_KEY_PUBLISHING=
AGENT_API_KEY_SALES=
AGENT_API_KEY_INVOICING=
AGENT_API_KEY_PURCHASES=
AGENT_API_KEY_BANKING=
AGENT_API_KEY_ACCOUNTING=
AGENT_API_KEY_TAX=
AGENT_API_KEY_MARKETING=
AGENT_API_KEY_TECHNICAL=

# =============================================================================
# API INTEGRACIÓN (FastAPI)
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_ENVIRONMENT=development
API_CORS_ORIGINS=http://localhost:3000,http://localhost:8002,https://hermes.transvega-animal.es

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Idempotencia
IDEMPOTENCY_TTL_HOURS=24

# =============================================================================
# SERVICIO APROBACIONES
# =============================================================================
APPROVALS_HOST=0.0.0.0
APPROVALS_PORT=8002
APPROVALS_DB_URL=postgresql://audit:${AUDIT_DB_PASSWORD}@audit-db:5432/audit
APPROVALS_REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/1

# Notificaciones aprobaciones (webhook Telegram/Slack/Email)
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=

# =============================================================================
# DASHBOARD INTERNO
# =============================================================================
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=3000
DASHBOARD_API_URL=http://api:8000
DASHBOARD_APPROVALS_URL=http://approvals:8000

# =============================================================================
# COLAS Y WORKERS
# =============================================================================
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=Europe/Madrid
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=3600
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_PREFETCH_MULTIPLIER=1

# Colas específicas
QUEUE_HIGH_PRIORITY=high
QUEUE_DEFAULT=default
QUEUE_LOW_PRIORITY=low
QUEUE_APPROVALS=approvals
QUEUE_NOTIFICATIONS=notifications

# =============================================================================
# HERMES / IA LOCAL
# =============================================================================
HERMES_HOST=hermes
HERMES_PORT=8080
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_MODELS=llama3.1:8b,mistral:7b,codellama:7b
VLLM_HOST=vllm
VLLM_PORT=8000

# =============================================================================
# BACKUPS
# =============================================================================
BACKUP_SCHEDULE=0 2 * * *                # Diario 02:00
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_KEY=                   # Generar: openssl rand -base64 32
BACKUP_GDRIVE_FOLDER_ID=                 # Folder ID en Google Drive
BACKUP_LOCAL_PATH=/backups
BACKUP_S3_ENDPOINT=                      # Opcional: S3 compatible
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# =============================================================================
# MONITORIZACIÓN
# =============================================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=
LOKI_PORT=3100
ALERTMANAGER_PORT=9093

# =============================================================================
# VERIFACTU (Fase posterior - solo análisis en fase 1-4)
# =============================================================================
VERIFACTU_PROVIDER=                      # modulo_dolibarr | proveedor_autorizado
VERIFACTU_CERT_PATH=
VERIFACTU_KEY_PATH=
VERIFACTU_TEST_MODE=true

# =============================================================================
# GESTORÍA PARALELA
# =============================================================================
GESTORIA_CONTACT_EMAIL=
GESTORIA_CONTACT_NAME=
GESTORIA_COMPARISON_SCHEDULE=0 9 1 * *   # Mensual día 1 09:00

# =============================================================================
# DESARROLLO / TESTING
# =============================================================================
PYTEST_DATABASE_URL=postgresql://audit:test@audit-db:5432/audit_test
MOCK_DOLIBARR_ENABLED=true
MOCK_DOLIBARR_PORT=8001
SEED_FAKE_DATA=true