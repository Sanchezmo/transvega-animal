# Dockerfile para Servicio Aprobaciones
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -r appuser && useradd -r -g appuser appuser

WORKDIR /app

COPY services/approval-service/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy as root first, then fix permissions
COPY services/approval-service/app/ ./app/
COPY services/approval-service/alembic/ ./alembic/
COPY services/approval-service/alembic.ini ./alembic.ini

# Fix permissions: ensure all files are readable by appuser
RUN chmod -R 644 /app && find /app -type d -exec chmod 755 {} \; && chown -R appuser:appuser /app

USER appuser

EXPOSE 8002

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8002/health/live || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8002"]