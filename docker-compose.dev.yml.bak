version: '3.8'

services:
  # =============================================================================
  # BASE DE DATOS AUDITORÍA (PostgreSQL - Independiente de Dolibarr)
  # =============================================================================
  audit-db:
    image: postgres:16-alpine
    container_name: transvega-audit-db
    environment:
      POSTGRES_DB: audit
      POSTGRES_USER: audit
      POSTGRES_PASSWORD: ${AUDIT_DB_PASSWORD}
      POSTGRES_INITDB_ARGS: "--auth-host=scram-sha-256"
    volumes:
      - audit-db-data:/var/lib/postgresql/data
      - ./infrastructure/docker/init-audit-db.sql:/docker-entrypoint-initdb.d/init.sql:ro
    ports:
      - "5432:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U audit -d audit"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - transvega-internal
    restart: unless-stopped

  # =============================================================================
  # REDIS (Cola de tareas + Cache + Sesiones)
  # =============================================================================
  redis:
    image: redis:7-alpine
    container_name: transvega-redis
    command: redis-server --requirepass ${REDIS_PASSWORD} --maxmemory 512mb --maxmemory-policy allkeys-lru
    volumes:
      - redis-data:/data
    ports:
      - "6379:6379"
    healthcheck:
      test: ["CMD", "redis-cli", "-a", "${REDIS_PASSWORD}", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - transvega-internal
    restart: unless-stopped

  # =============================================================================
  # MOCK DOLIBARR (Desarrollo - Simula API Dolibarr)
  # =============================================================================
  mock-dolibarr:
    build:
      context: .
      dockerfile: infrastructure/docker/Dockerfile.mock-dolibarr
    container_name: transvega-mock-dolibarr
    environment:
      - ENVIRONMENT=development
      - MOCK_DOLIBARR_API_KEY=mock-admin-key-123
      - MOCK_DOLIBARR_AGENT_KEY=mock-agent-key-456
      - MOCK_DOLIBARR_READONLY_KEY=mock-readonly-key-789
    ports:
      - "8001:8001"
    volumes:
      - ./tests/fixtures/dolibarr:/app/fixtures:ro
    networks:
      - transvega-internal
    restart: unless-stopped

  # =============================================================================
  # API INTEGRACIÓN (FastAPI - Punto central de integración)
  # =============================================================================
  api:
    build:
      context: .
      dockerfile: infrastructure/docker/Dockerfile.api
    container_name: transvega-api
    environment:
      - ENVIRONMENT=development
      - API_HOST=0.0.0.0
      - API_PORT=8000
      - AUDIT_DB_URL=postgresql+asyncpg://audit:${AUDIT_DB_PASSWORD}@audit-db:5432/audit
      - REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
      - DOLIBARR_API_URL=http://mock-dolibarr:8001
      - DOLIBARR_API_KEY=${DOLIBARR_API_KEY}
      - JWT_SECRET_KEY=${JWT_SECRET_KEY}
      - FERNET_KEY=${FERNET_KEY}
      - CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
      - CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/2
      - MOCK_DOLIBARR_ENABLED=true
      # Individual fields required by Settings
      - AUDIT_DB_PASSWORD=${AUDIT_DB_PASSWORD}
      - REDIS_PASSWORD=${REDIS_PASSWORD}
      - JWT_SECRET_KEY=${JWT_SECRET_KEY}
      - FERNET_KEY=${FERNET_KEY}
      - AGENT_API_KEY_SUPERVISOR=${AGENT_API_KEY_SUPERVISOR}
      - AGENT_API_KEY_PRODUCTS=${AGENT_API_KEY_PRODUCTS}
      - AGENT_API_KEY_COMPLIANCE=${AGENT_API_KEY_COMPLIANCE}
      - AGENT_API_KEY_PUBLISHING=${AGENT_API_KEY_PUBLISHING}
      - AGENT_API_KEY_SALES=${AGENT_API_KEY_SALES}
      - AGENT_API_KEY_INVOICING=${AGENT_API_KEY_INVOICING}
      - AGENT_API_KEY_PURCHASES=${AGENT_API_KEY_PURCHASES}
      - AGENT_API_KEY_BANKING=${AGENT_API_KEY_BANKING}
      - AGENT_API_KEY_ACCOUNTING=${AGENT_API_KEY_ACCOUNTING}
      - AGENT_API_KEY_TAX=${AGENT_API_KEY_TAX}
      - AGENT_API_KEY_MARKETING=${AGENT_API_KEY_MARKETING}
      - AGENT_API_KEY_TECHNICAL=${AGENT_API_KEY_TECHNICAL}
    ports:
      - "8000:8000"
    # No volumes - files copied in Dockerfile
    depends_on:
      audit-db:
        condition: service_healthy
      redis:
        condition: service_healthy
      mock-dolibarr:
        condition: service_started
    networks:
      - transvega-internal
    restart: unless-stopped
    deploy:
      resources:
        limits:
          memory: 1G
        reservations:
          memory: 512M

  # =============================================================================
  # WORKER CELERY (Procesamiento de tareas en background)
  # =============================================================================
  worker:
    build:
      context: .
      dockerfile: infrastructure/docker/Dockerfile.worker
    container_name: transvega-worker
    environment:
      - ENVIRONMENT=development
      - CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
      - CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/2
      - AUDIT_DB_URL=postgresql+asyncpg://audit:${AUDIT_DB_PASSWORD}@audit-db:5432/audit
      - DOLIBARR_API_URL=http://mock-dolibarr:8001
      - DOLIBARR_API_KEY=${DOLIBARR_API_KEY}
      - JWT_SECRET_KEY=${JWT_SECRET_KEY}
      # Individual fields required by Settings
      - AUDIT_DB_PASSWORD=${AUDIT_DB_PASSWORD}
      - REDIS_PASSWORD=${REDIS_PASSWORD}
      - JWT_SECRET_KEY=${JWT_SECRET_KEY}
      - FERNET_KEY=${FERNET_KEY}
      - AGENT_API_KEY_SUPERVISOR=${AGENT_API_KEY_SUPERVISOR}
      - AGENT_API_KEY_PRODUCTS=${AGENT_API_KEY_PRODUCTS}
      - AGENT_API_KEY_COMPLIANCE=${AGENT_API_KEY_COMPLIANCE}
      - AGENT_API_KEY_PUBLISHING=${AGENT_API_KEY_PUBLISHING}
      - AGENT_API_KEY_SALES=${AGENT_API_KEY_SALES}
      - AGENT_API_KEY_INVOICING=${AGENT_API_KEY_INVOICING}
      - AGENT_API_KEY_PURCHASES=${AGENT_API_KEY_PURCHASES}
      - AGENT_API_KEY_BANKING=${AGENT_API_KEY_BANKING}
      - AGENT_API_KEY_ACCOUNTING=${AGENT_API_KEY_ACCOUNTING}
      - AGENT_API_KEY_TAX=${AGENT_API_KEY_TAX}
      - AGENT_API_KEY_MARKETING=${AGENT_API_KEY_MARKETING}
      - AGENT_API_KEY_TECHNICAL=${AGENT_API_KEY_TECHNICAL}
    # No volumes - files copied in Dockerfile
    depends_on:
      redis:
        condition: service_healthy
      audit-db:
        condition: service_healthy
      api:
        condition: service_started
    networks:
      - transvega-internal
    restart: unless-stopped
    deploy:
      resources:
        limits:
          memory: 2G
        reservations:
          memory: 1G

  # =============================================================================
  # SERVICIO APROBACIONES (Panel humano para aprobaciones sensibles)
  # =============================================================================
  approvals:
    build:
      context: .
      dockerfile: infrastructure/docker/Dockerfile.approvals
    container_name: transvega-approvals
    environment:
      - ENVIRONMENT=development
      - APPROVALS_PORT=8002
      - APPROVALS_DB_URL=postgresql+asyncpg://audit:${AUDIT_DB_PASSWORD}@audit-db:5432/audit
      - APPROVALS_REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/1
      - NOTIFICATION_WEBHOOK_URL=${NOTIFICATION_WEBHOOK_URL}
      - NOTIFICATION_WEBHOOK_SECRET=${NOTIFICATION_WEBHOOK_SECRET}
      # Individual fields required by Settings
      - AUDIT_DB_PASSWORD=${AUDIT_DB_PASSWORD}
      - REDIS_PASSWORD=${REDIS_PASSWORD}
      - JWT_SECRET_KEY=${JWT_SECRET_KEY}
      - FERNET_KEY=${FERNET_KEY}
    ports:
      - "127.0.0.1:8002:8002"
    # No volumes - files copied in Dockerfile
    depends_on:
      audit-db:
        condition: service_healthy
      redis:
        condition: service_healthy
    networks:
      - transvega-internal
    restart: unless-stopped

  # =============================================================================
  # DASHBOARD INTERNO (Panel de control y observabilidad)
  # =============================================================================
  dashboard:
    build:
      context: .
      dockerfile: infrastructure/docker/Dockerfile.dashboard
    container_name: transvega-dashboard
    environment:
      - ENVIRONMENT=development
      - DASHBOARD_PORT=3000
      - DASHBOARD_API_URL=http://api:8000
      - DASHBOARD_APPROVALS_URL=http://approvals:8002
    ports:
      - "3000:3000"
    # No volumes - files copied in Dockerfile
    depends_on:
      - api
      - approvals
    networks:
      - transvega-internal
    restart: unless-stopped

  # =============================================================================
  # MONITORIZACIÓN (Prometheus, Grafana, Loki, Alertmanager)
  # =============================================================================
  prometheus:
    image: prom/prometheus:v2.53.0
    container_name: transvega-prometheus
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--storage.tsdb.path=/prometheus'
      - '--storage.tsdb.retention.time=30d'
    volumes:
      - ./infrastructure/monitoring/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus-data:/prometheus
    ports:
      - "9090:9090"
    networks:
      - transvega-internal
    restart: unless-stopped

  grafana:
    image: grafana/grafana:10.4.0
    container_name: transvega-grafana
    environment:
      - GF_SECURITY_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD}
      - GF_USERS_ALLOW_SIGN_UP=false
      - GF_INSTALL_PLUGINS=grafana-piechart-panel
    volumes:
      - ./infrastructure/monitoring/grafana-dashboards:/etc/grafana/provisioning/dashboards:ro
      - ./infrastructure/monitoring/grafana-datasources.yml:/etc/grafana/provisioning/datasources/datasources.yml:ro
      - grafana-data:/var/lib/grafana
    ports:
      - "3001:3000"
    depends_on:
      - prometheus
    networks:
      - transvega-internal
    restart: unless-stopped

  loki:
    image: grafana/loki:2.9.0
    container_name: transvega-loki
    command: -config.file=/etc/loki/local-config.yaml
    volumes:
      - loki-data:/loki
    ports:
      - "3100:3100"
    networks:
      - transvega-internal
    restart: unless-stopped

  alertmanager:
    image: prom/alertmanager:v0.27.0
    container_name: transvega-alertmanager
    volumes:
      - ./infrastructure/monitoring/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro
      - alertmanager-data:/alertmanager
    ports:
      - "9093:9093"
    networks:
      - transvega-internal
    restart: unless-stopped

  # =============================================================================
  # OLLAMA (Modelos IA locales)
  # =============================================================================
  ollama:
    image: ollama/ollama:latest
    container_name: transvega-ollama
    volumes:
      - ollama-data:/root/.ollama
    ports:
      - "11434:11434"
    environment:
      - OLLAMA_MODELS=${OLLAMA_MODELS}
    networks:
      - transvega-internal
    restart: unless-stopped
    deploy:
      resources:
        limits:
          memory: 16G
        reservations:
          memory: 8G

  # =============================================================================
  # DOLIBARR (ERP/CRM oficial)
  # =============================================================================
  dolibarr:
    image: dolibarr/dolibarr:18
    container_name: dolibarr
    restart: unless-stopped
    depends_on:
      - db-dolibarr
    environment:
      - DOLIBARR_DB_HOST=db-dolibarr
      - DOLIBARR_DB_PORT=3306
      - DOLIBARR_DB_NAME=dolibarr
      - DOLIBARR_DB_USER=dolibuser
      - DOLIBARR_DB_PASSWORD=dolibarr_password
      - DOLIBARR_ADMIN_LOGIN=admin
      - DOLIBARR_ADMIN_PASSWORD=admin_password
      - TZ=Europe/Madrid
    ports:
      - "8080:80"
    volumes:
      - dolibarr_data:/var/www/html/documents
      - dolibarr_custom:/var/www/html/custom
    networks:
      - transvega-internal

  # =============================================================================
  # BASE DE DATOS DEDICADA PARA DOLIBARR (MariaDB)
  # =============================================================================
  db-dolibarr:
    image: mariadb:10.11
    container_name: db-dolibarr
    restart: unless-stopped
    environment:
      - MYSQL_ROOT_PASSWORD=root_password
      - MYSQL_DATABASE=dolibarr
      - MYSQL_USER=dolibuser
      - MYSQL_PASSWORD=dolibarr_password
    volumes:
      - dolibarr_db:/var/lib/mysql
    networks:
      - transvega-internal

networks:
  transvega-internal:
    driver: bridge
    ipam:
      config:
        - subnet: 172.28.0.0/16

  dolibarr_data:
  dolibarr_custom:
  dolibarr_db:
volumes:
  audit-db-data:
  redis-data:
  prometheus-data:
  grafana-data:
  loki-data:
  alertmanager-data:
  ollama-data: