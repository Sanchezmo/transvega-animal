# Staging Environment Configuration Example
# Copy this file to .env.staging and fill in the actual values
# NEVER commit the real .env.staging to version control

# =============================================================================
# APPLICATION
# =============================================================================
ENVIRONMENT=staging
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
DEBUG=false

# =============================================================================
# AUDIT DATABASE (PostgreSQL)
# =============================================================================
AUDIT_DB_HOST=audit-db
AUDIT_DB_PORT=5432
AUDIT_DB_NAME=audit
AUDIT_DB_USER=audit
AUDIT_DB_PASSWORD=CHANGE_ME

# =============================================================================
# REDIS
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# =============================================================================
# DOLIBARR (External ERP)
# =============================================================================
DOLIBARR_API_URL=http://mock-dolibarr:8001
DOLIBARR_API_KEY=CHANGE_ME
DOLIBARR_TIMEOUT=30

# =============================================================================
# INTERNAL API URL (for service-to-service communication)
# =============================================================================
INTERNAL_API_URL=http://api:8000/api/v1

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=7
FERNET_KEY=CHANGE_ME

# =============================================================================
# AGENT API KEYS (Generate unique keys for each agent)
# =============================================================================
AGENT_API_KEY_SUPERVISOR=CHANGE_ME
AGENT_API_KEY_PRODUCTS=CHANGE_ME
AGENT_API_KEY_COMPLIANCE=CHANGE_ME
AGENT_API_KEY_PUBLISHING=CHANGE_ME
AGENT_API_KEY_SALES=CHANGE_ME
AGENT_API_KEY_INVOICING=CHANGE_ME
AGENT_API_KEY_PURCHASES=CHANGE_ME
AGENT_API_KEY_BANKING=CHANGE_ME
AGENT_API_KEY_ACCOUNTING=CHANGE_ME
AGENT_API_KEY_TAX=CHANGE_ME
AGENT_API_KEY_MARKETING=CHANGE_ME
AGENT_API_KEY_TECHNICAL=CHANGE_ME
AGENT_API_KEY_DOG_INTAKE=CHANGE_ME
AGENT_API_KEY_EXPEDIENTES=CHANGE_ME
AGENT_API_KEY_FACTURACION=CHANGE_ME

# =============================================================================
# TELEGRAM BOT
# =============================================================================
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME
TELEGRAM_WEBHOOK_SECRET_REQUIRED=true
TELEGRAM_UPDATE_IDEMPOTENCY_TTL_HOURS=24

# =============================================================================
# OLLAMA (Local LLM for invoice processing - LOCAL_ONLY)
# =============================================================================
OLLAMA_ENDPOINT=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_VISION_MODEL=llava:7b

# =============================================================================
# NVIDIA (Optional - for cloud AI fallback, NOT for invoices)
# =============================================================================
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# =============================================================================
# CELERY (Task queue)
# =============================================================================
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=["json"]
CELERY_TIMEZONE=Europe/Madrid
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=3600
CELERY_WORKER_PREFETCH_MULTIPLIER=4
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_DEFAULT_QUEUE=default

# =============================================================================
# APPROVALS SERVICE
# =============================================================================
APPROVALS_SERVICE_URL=http://approvals:8000

# =============================================================================
# NOTIFICATIONS
# =============================================================================
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=

# =============================================================================
# LOGGING & METRICS
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
METRICS_ENABLED=true
METRICS_PORT=9090

# =============================================================================
# RATE LIMITING & IDEMPOTENCY
# =============================================================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
IDEMPOTENCY_TTL_HOURS=24
TELEGRAM_UPDATE_IDEMPOTENCY_TTL_HOURS=24

# =============================================================================
# CLOUDFLARE TUNNEL (for staging HTTPS access)
# =============================================================================
CLOUDFLARE_TUNNEL_TOKEN_STAGING=CHANGE_ME

# =============================================================================
# OLLAMA MODELS (for local LLM)
# =============================================================================
OLLAMA_MODELS=llama3.1:8b,llava:7b

# =============================================================================
# GOOGLE WORKSPACE (Optional)
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WORKSPACE_DOMAIN=transvega-animal.es

# =============================================================================
# CLOUDFLARE (Optional)
# =============================================================================
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# =============================================================================
# VERIFACTU (Optional - Spanish tax compliance)
# =============================================================================
VERIFACTU_PROVIDER=
VERIFACTU_CERT_PATH=
VERIFACTU_KEY_PATH=
VERIFACTU_TEST_MODE=true