# Dockerfile para Mock Dolibarr (FastAPI simulando API Dolibarr)
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -r appuser && useradd -r -g appuser appuser

WORKDIR /app

COPY adapters/dolibarr/mock_requirements.txt .
RUN pip install --no-cache-dir -r mock_requirements.txt

COPY --chown=appuser:appuser adapters/dolibarr/mock.py .
COPY --chown=appuser:appuser tests/fixtures/dolibarr ./fixtures

USER appuser

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8001/health || exit 1

CMD ["uvicorn", "mock:app", "--host", "0.0.0.0", "--port", "8001"]