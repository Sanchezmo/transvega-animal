# =============================================================================
# CONFIGURACIÓN EXCLUSIVA PARA TESTS DE INTEGRACIÓN LOCALES
# =============================================================================
# NO contiene secretos reales - solo fixtures de test
# Usar con: source .env.test && pytest tests/integration
# O con: docker compose -f docker-compose.test.yml --env-file .env.test up -d

# Entorno
ENVIRONMENT=test
DEBUG=true

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Base de datos de test (postgres-test en docker-compose.test.yml)
AUDIT_DB_HOST=127.0.0.1
AUDIT_DB_PORT=55432
AUDIT_DB_NAME=transvega_test
AUDIT_DB_USER=transvega_test
AUDIT_DB_PASSWORD=transvega_test

# Redis de test (redis-test en docker-compose.test.yml)
REDIS_HOST=127.0.0.1
REDIS_PORT=56379
REDIS_PASSWORD=

# Dolibarr - usa mock para tests
DOLIBARR_API_URL=http://localhost:8001
DOLIBARR_API_KEY=test_dolibarr_key
DOLIBARR_TIMEOUT=30
MOCK_DOLIBARR_ENABLED=true

# JWT & Cifrado (claves de test, NO secretos reales)
JWT_SECRET_KEY=test-secret-key-for-testing-only-32chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=7
FERNET_KEY=ZmDfcTF7_60GrrY167zsiPd67pEvs0aGOv2oasOM1Rg=

# API Keys por agente (prefijo tvsk_ = test key)
AGENT_API_KEY_SUPERVISOR=tvsk_test_supervisor_key_123
AGENT_API_KEY_PRODUCTS=tvsk_test_products_key_123
AGENT_API_KEY_COMPLIANCE=tvsk_test_compliance_key_123
AGENT_API_KEY_PUBLISHING=tvsk_test_publishing_key_123
AGENT_API_KEY_SALES=tvsk_test_sales_key_123
AGENT_API_KEY_INVOICING=tvsk_test_invoicing_key_123
AGENT_API_KEY_PURCHASES=tvsk_test_purchases_key_123
AGENT_API_KEY_BANKING=tvsk_test_banking_key_123
AGENT_API_KEY_ACCOUNTING=tvsk_test_accounting_key_123
AGENT_API_KEY_TAX=tvsk_test_tax_key_123
AGENT_API_KEY_MARKETING=tvsk_test_marketing_key_123
AGENT_API_KEY_TECHNICAL=tvsk_test_technical_key_123
AGENT_API_KEY_DOG_INTAKE=tvsk_test_dog_intake_key_123
AGENT_API_KEY_EXPEDIENTES=tvsk_test_expedientes_key_123
AGENT_API_KEY_FACTURACION=tvsk_test_facturacion_key_123

# Aprobaciones
APPROVALS_SERVICE_URL=http://localhost:8002

# Notificaciones
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=

# Telegram (mock en tests)
TELEGRAM_WEBHOOK_SECRET=test_telegram_webhook_secret
TELEGRAM_WEBHOOK_SECRET_REQUIRED=false
TELEGRAM_BOT_TOKEN=test_bot_token
TELEGRAM_UPDATE_IDEMPOTENCY_TTL_HOURS=24

# Google Workspace (no usado en tests)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WORKSPACE_DOMAIN=transvega-animal.es

# Cloudflare (no usado en tests)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# Logs
LOG_LEVEL=DEBUG
LOG_FORMAT=json

# Métricas
METRICS_ENABLED=false
METRICS_PORT=9090

# VeriFactu
VERIFACTU_PROVIDER=
VERIFACTU_CERT_PATH=
VERIFACTU_KEY_PATH=
VERIFACTU_TEST_MODE=true

# Celery (usa redis-test)
CELERY_BROKER_URL=redis://127.0.0.1:56379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:56379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=["json"]
CELERY_TIMEZONE=Europe/Madrid
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=3600
CELERY_WORKER_PREFETCH_MULTIPLIER=4
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_DEFAULT_QUEUE=default

# Rate limiting & Idempotencia
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
IDEMPOTENCY_TTL_HOURS=24

# Ollama (no usado en tests normales, mock en tests de facturas)
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=transvega-local

# NVIDIA (no usado en tests)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=

# Internal API
INTERNAL_API_URL=http://localhost:8000/api/v1
AGENT_API_KEY_LISTING=tvsk_test_listing_key_123
