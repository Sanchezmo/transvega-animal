# Dockerfile para Worker Celery
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -r appuser && useradd -r -g appuser appuser

WORKDIR /app

COPY services/integration-api/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy with correct ownership
COPY --chown=appuser:appuser services/integration-api/app ./app
COPY --chown=appuser:appuser adapters ./adapters
COPY --chown=appuser:appuser shared ./shared
COPY --chown=appuser:appuser agents ./agents
COPY --chown=appuser:appuser services/task-queue ./tasks

# Create tasks module init if needed
RUN touch /app/tasks/__init__.py && chown appuser:appuser /app/tasks/__init__.py
# Copy celery_app.py to tasks root for easier import
RUN cp /app/tasks/app/celery_app.py /app/tasks/celery_app.py && chown appuser:appuser /app/tasks/celery_app.py

USER appuser

# Health check para worker
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD celery -A tasks.celery_app inspect ping -d celery@${HOSTNAME} || exit 1

CMD ["celery", "-A", "tasks.celery_app", "worker", "--loglevel=info", "--concurrency=4", "--queues=high,default,low,approvals,notifications"]